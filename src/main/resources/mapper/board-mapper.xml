<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- 해당 파일에 모든 쿼리문을 작성 -->
<!-- namespace에는 xml파일과 연결할 Mapper interface 파일명을 패키지를 포함하여 적어주세요 -->
<mapper namespace="com.green.r_board.mapper.BoardMapper">
	<resultMap id="board" type="com.green.r_board.dto.BoardDTO">
    <id column="BOARD_NUM" property="boardNum"/>
    <result column="CATE_NUM" property="cateNum"/>
    <result column="TITLE" property="title"/>
    <result column="CONTENT" property="content"/>
    <result column="WRITER" property="writer"/>
    <result column="CREATE_DATE" property="createDate"/>
    <association property="categoryDTO" resultMap="com.green.r_board.mapper.CategoryMapper.category"/>
  </resultMap>
  <!--게시글 목록 조회-->
  <select id="selectBoardList" resultMap="board">
    SELECT
      BOARD_NUM
      , TITLE
      , WRITER
      , CREATE_DATE
    FROM R_BOARD
    ORDER BY BOARD_NUM DESC
  </select>

  <!--게시글 상세 조회-->
  <select id="selectBoard" resultMap="board">
    SELECT
      BOARD_NUM
      , TITLE
      , WRITER
      , CONTENT
      , CREATE_DATE
      , CATE_NAME
    FROM R_BOARD B
    INNER JOIN R_CATEGORY C
    ON B.CATE_NUM = C.CATE_NUM
    WHERE BOARD_NUM = #{boardNum}
  </select>

  <!--게시글 등록-->
  <insert id="insertBoard">
    INSERT INTO R_BOARD(
      CATE_NUM
      , TITLE
      , CONTENT
      , WRITER
    )VALUES(
      #{cateNum}
      , #{title}
      , #{content}
      , #{writer}
    )
  </insert>

  <!--게시글 삭제-->
  <delete id="deleteBoard">
    DELETE FROM R_BOARD
    WHERE BOARD_NUM = #{boardNum}
  </delete>

  <!--게시글 수정-->
  <update id="updateBoard">
    UPDATE R_BOARD
    SET
      CATE_NUM = #{cateNum}
      , TITLE = #{title}
      , CONTENT = #{content}
    WHERE BOARD_NUM = #{boardNum}
  </update>

</mapper>































